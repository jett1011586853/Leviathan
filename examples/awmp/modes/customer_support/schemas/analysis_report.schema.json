{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["modeId", "summary", "topIssues", "approvalRequired"],
  "properties": {
    "modeId": { "const": "com.leviathan.customer_support" },
    "summary": { "type": "string" },
    "topIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "count", "severity"],
        "properties": {
          "label": { "type": "string" },
          "count": { "type": "number" },
          "severity": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "approvalRequired": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "reason", "permission"],
        "properties": {
          "caseId": { "type": "string" },
          "reason": { "type": "string" },
          "permission": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
