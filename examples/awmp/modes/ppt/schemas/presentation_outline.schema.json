{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["modeId", "slides"],
  "properties": {
    "modeId": { "const": "com.leviathan.ppt" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "bullets"],
        "properties": {
          "title": { "type": "string" },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
